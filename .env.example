# Caudo - variables para docker-compose.
# Uso:  cp .env.example .env   y edite los valores marcados como OBLIGATORIA.
# No suba el archivo .env al repositorio (contiene secretos).

# --- Base de datos (PostgreSQL) ---
DB_USERNAME=postgres
DB_NAME=caudo
# OBLIGATORIA: contrasena de PostgreSQL
DB_PASSWORD=cambie_esta_contrasena

# --- API ---
# OBLIGATORIA: cadena larga y aleatoria para firmar los tokens JWT
JWT_SECRET=cambie_este_secreto_por_una_cadena_larga_y_aleatoria
JWT_EXPIRATION=24h
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:4200

# --- n8n (automatizacion, opcional) ---
N8N_USER=admin
# OBLIGATORIA: docker compose no arranca sin este valor
N8N_PASSWORD=cambie_esta_contrasena
# Opcional: tras importar y activar n8n/workflows/recomendaciones.json
# N8N_RECOMMENDATIONS_WEBHOOK=http://n8n:5678/webhook/caudo-recomendaciones
N8N_RECOMMENDATIONS_WEBHOOK=

# --- Cuentas iniciales (se crean al arrancar si correo y contrasena estan definidos) ---
# La contrasena debe tener 8+ caracteres, mayuscula, minuscula, numero y un simbolo de @$!%*?&
ADMIN_EMAIL=admin@ejemplo.com
ADMIN_PASSWORD=
ADMIN_NOMBRE=Administrador Caudo
# Usuario de demostracion (opcional)
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=

# --- IA generativa (Google Gemini), opcional ---
# Sin clave el sistema usa solo reglas. Clave gratuita en https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Si es true, las descripciones que las reglas no reconocen se envian a Google para clasificarlas.
AI_CATEGORIZATION=false
