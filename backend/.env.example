DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_db_password_here
DB_NAME=caudo
DB_SSL=false
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRATION=24h
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880
NODE_ENV=development
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:4200

# Opcional: webhook de n8n para mejorar la redacción de las recomendaciones
N8N_RECOMMENDATIONS_WEBHOOK=

# Administrador inicial (se crea al arrancar si ambos están definidos; el registro público nunca crea admins).
# La contraseña debe tener 8+ caracteres, mayúscula, minúscula, número y símbolo (@$!%*?&).
ADMIN_EMAIL=admin@ejemplo.com
ADMIN_PASSWORD=
ADMIN_NOMBRE=Administrador Caudo
# Usuario de demostración (opcional)
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=
# Origen de n8n para el estado en el panel (opcional; si falta se deduce del webhook)
N8N_BASE_URL=

# IA generativa (Google Gemini) — opcional. Sin clave, el sistema usa solo las reglas.
# Clave gratuita en https://aistudio.google.com (no la subas a GitHub).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Si es true, las transacciones que las palabras clave no reconocen se clasifican con IA.
# ATENCIÓN: esto envía la descripción de la transacción a Google. Déjalo en false si no hay consentimiento.
AI_CATEGORIZATION=false
